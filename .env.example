# ─── LLM Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
VOYAGE_API_KEY=your_voyage_api_key_here

# ─── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_BASE64=base64_encoded_rsa_private_key
JWT_PUBLIC_KEY_BASE64=base64_encoded_rsa_public_key
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
JWT_REFRESH_TOKEN_TTL_SECONDS=604800

# ─── Postgres (per service) ─────────────────────────────────────────────────────
POSTGRES_STRATEGY_URL=postgresql://campaignos:campaignos@localhost:5432/strategy_db
POSTGRES_AUDIENCE_URL=postgresql://campaignos:campaignos@localhost:5433/audience_db
POSTGRES_TARGETING_URL=postgresql://campaignos:campaignos@localhost:5434/targeting_db
POSTGRES_EXPERIENCE_URL=postgresql://campaignos:campaignos@localhost:5435/experience_db
POSTGRES_EXPERIMENT_URL=postgresql://campaignos:campaignos@localhost:5436/experiment_db
POSTGRES_MEASUREMENT_URL=postgresql://campaignos:campaignos@localhost:5437/measurement_db
POSTGRES_RECOMMENDATION_URL=postgresql://campaignos:campaignos@localhost:5438/recommendation_db
POSTGRES_OFFER_URL=postgresql://campaignos:campaignos@localhost:5439/offer_db
POSTGRES_BUNDLE_URL=postgresql://campaignos:campaignos@localhost:5440/bundle_db
POSTGRES_CREATIVE_URL=postgresql://campaignos:campaignos@localhost:5441/creative_db
POSTGRES_SEMANTIC_URL=postgresql://campaignos:campaignos@localhost:5442/semantic_db
POSTGRES_ACTIVATION_URL=postgresql://campaignos:campaignos@localhost:5443/activation_db
POSTGRES_TEMPORAL_URL=postgresql://temporal:temporal@localhost:5444/temporal_db

# ─── Redis ───────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:campaignos_redis@localhost:6379

# ─── Kafka / Redpanda ────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ─── Neo4j ───────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=campaignos_neo4j

# ─── MinIO ───────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=campaignos_minio
MINIO_SECRET_KEY=campaignos_minio_secret
MINIO_USE_SSL=false

# ─── Temporal ────────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=campaignos-dev

# ─── OpenTelemetry ───────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=campaignos-local
OTEL_ENVIRONMENT=development

# ─── Service Internal API Keys ───────────────────────────────────────────────────
# Format: svc_{service_name}_{random}
SVC_KEY_STRATEGY=svc_strategy_changeme
SVC_KEY_AUDIENCE=svc_audience_changeme
SVC_KEY_TARGETING=svc_targeting_changeme
SVC_KEY_EXPERIENCE=svc_experience_changeme
SVC_KEY_EXPERIMENT=svc_experiment_changeme
SVC_KEY_MEASUREMENT=svc_measurement_changeme
SVC_KEY_RECOMMENDATION=svc_recommendation_changeme
SVC_KEY_OFFER=svc_offer_changeme
SVC_KEY_BUNDLE=svc_bundle_changeme
SVC_KEY_CREATIVE=svc_creative_changeme
SVC_KEY_SEMANTIC=svc_semantic_changeme
SVC_KEY_ACTIVATION=svc_activation_changeme

# ─── Agent Config ────────────────────────────────────────────────────────────────
AGENT_LLM_STUB=false
AGENT_MAX_RETRIES=3
AGENT_DEFAULT_TOKEN_BUDGET=20000

# ─── Frontend ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
